# Copy thành .env và chỉnh lại cho môi trường của bạn.
# Local: docker compose up -d  (host port 5433)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/aurel"

# Secret ký session cookie (tự sinh chuỗi ngẫu nhiên khi deploy)
JWT_SECRET="thay-bang-chuoi-ngau-nhien-64-ky-tu"
# VNPay sandbox (lấy tại https://sandbox.vnpayment.vn, mục Tài khoản test).
# Chưa có thì để trống: nút VNPay sẽ báo thiếu cấu hình, các phương thức khác vẫn chạy.
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
# VNPAY_URL mặc định trong code đã là sandbox, chỉ override khi cần.
#VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
