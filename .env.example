# Copy thành .env và chỉnh lại cho môi trường của bạn.
# URL backend NestJS riêng (REST). BACKEND_URL cho Server Components/proxy,
# NEXT_PUBLIC_BACKEND_URL cho Client Components (phải cùng giá trị khi dev).
BACKEND_URL="http://localhost:4000"
NEXT_PUBLIC_BACKEND_URL="http://localhost:4000"
# CDN media tĩnh (bỏ trống = serve local như hiện tại). Prod VD:
# NEXT_PUBLIC_MEDIA_BASE_URL="https://media.shop.example.com"
NEXT_PUBLIC_MEDIA_BASE_URL=""
