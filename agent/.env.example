# AI Agent cho Aurel & Co. — biến môi trường
# Copy thành agent/.env rồi điền giá trị. KHÔNG commit agent/.env.

# --- Provider LLM (bất kỳ gateway nào tương thích Anthropic Messages API) ---
# Ví dụ: z.ai, OpenRouter (route anthropic/claude-*), Bedrock/Vertex proxy, LiteLLM...
# Bỏ trống AGENT_BASE_URL nếu dùng api.anthropic.com mặc định.
AGENT_BASE_URL=
AGENT_API_KEY=
# Tên model theo gateway của bạn (mặc định của upstream là claude-sonnet-5)
AGENT_MODEL=claude-sonnet-5

# --- Backend clock (NestJS, mặc định dev) ---
AUREL_BACKEND_URL=http://localhost:4000

# --- Tài khoản demo cho agent host ---
# Shopping agent cần 1 tài khoản khách hàng để giữ giỏ hàng.
AGENT_SHOPPER_EMAIL=agent-shopper@aurel.local
AGENT_SHOPPER_PASSWORD=AgentShopper1!
# Merchant agent cần tài khoản ADMIN. Chỉ dùng ở dev; ở prod nên cấp
# một service-account riêng có quyền admin thay vì dùng admin chính.
AGENT_ADMIN_EMAIL=admin@aurel.local
AGENT_ADMIN_PASSWORD=Admin123!

# --- Host ---
AGENT_HOST=127.0.0.1
AGENT_PORT=8100
