# AI Agent cho Aurel & Co. — biến môi trường
# Copy thành agent/.env rồi điền giá trị. KHÔNG commit agent/.env.

# --- Provider LLM (bất kỳ gateway nào tương thích Anthropic Messages API) ---
# Bỏ trống AGENT_BASE_URL nếu dùng api.anthropic.com mặc định.
#
# DeepSeek (hỗ trợ Anthropic API gốc — tools/tool_use đầy đủ):
#   AGENT_BASE_URL=https://api.deepseek.com/anthropic
#   AGENT_MODEL=deepseek-chat            (hoặc deepseek-reasoner)
#   AGENT_AUTH_HEADER=x-api-key          (mặc định)
#   Lưu ý: DeepSeek tự map tên "claude-*" → model của họ nếu bạn quên đổi
#   AGENT_MODEL (claude-sonnet/haiku → deepseek-flash, claude-opus → v4-pro).
#
# OpenRouter (endpoint /v1/messages có, nhưng cần Bearer):
#   AGENT_BASE_URL=https://openrouter.ai/api/v1
#   AGENT_MODEL=anthropic/claude-sonnet-5   (hoặc deepseek/deepseek-chat, ...)
#   AGENT_AUTH_HEADER=bearer
#
# LiteLLM proxy (tự dịch sang provider bất kỳ — xem vendor/docs/deployment.md):
#   AGENT_BASE_URL=http://localhost:4000   (proxy LiteLLM của bạn)
#   AGENT_AUTH_HEADER=x-api-key
#
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=claude-sonnet-5
# x-api-key (chuẩn Anthropic) | bearer (OpenRouter...)
AGENT_AUTH_HEADER=x-api-key

# --- Backend clock (NestJS, mặc định dev) ---
AUREL_BACKEND_URL=http://localhost:4000

# --- Tài khoản demo cho agent host ---
# Shopping agent cần 1 tài khoản khách hàng để giữ giỏ hàng.
AGENT_SHOPPER_EMAIL=agent-shopper@aurel.local
AGENT_SHOPPER_PASSWORD=AgentShopper1!
# Merchant agent cần tài khoản ADMIN. Chỉ dùng ở dev; ở prod nên cấp
# một service-account riêng có quyền admin thay vì dùng admin chính.
AGENT_ADMIN_EMAIL=admin@aurel.local
AGENT_ADMIN_PASSWORD=Admin123!

# --- Host ---
AGENT_HOST=127.0.0.1
AGENT_PORT=8100
