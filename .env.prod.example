# Copy thành .env.prod (KHÔNG commit). Dùng với:
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Domain đã trỏ DNS về VPS (Caddy tự cấp TLS).
DOMAIN="shop.example.com"
# Site URL tuyệt đối cho sitemap/robots (SEO) — trùng DOMAIN, có https.
SITE_URL="https://shop.example.com"

# Postgres (đặt mật khẩu mạnh, chỉ dùng nội bộ compose).
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="doi-mat-khau-manh-o-day"
POSTGRES_DB="aurel"

# JWT (chuỗi ngẫu nhiên ≥64 ký tự, khác hoàn toàn môi trường dev).
# Sinh bằng: openssl rand -hex 32
JWT_SECRET="tao-moi-bang-openssl-rand-hex-32"

# VNPay production (lấy ở merchant portal; để trống = tắt VNPay).
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""

# Chế độ cổng VNPay: "production" = cổng thật (bắt buộc đủ TMN code phía trên).
VNPAY_ENV="sandbox"

# TTL URL thanh toán VNPay (phút, 10-1440, mặc định 30) — sau TTL cổng từ chối,
# khách không thể mở link cũ của đơn đã hết hạn.
VNPAY_URL_TTL_MINUTES="30"

# Giới hạn đơn PENDING (giờ, mặc định 6) — cron expire + trả tồn kho.
ORDER_PENDING_TTL_HOURS="6"

# Admin seed (bắt buộc ở prod — thiếu thì seed từ chối chạy).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Cost bcrypt (4-15). Prod khuyến nghị 12 (~250ms/hash, chặn brute-force
# offline); 10 mặc định cho dev/test cho nhanh.
BCRYPT_COST="12"

# Ảnh upload S3 (bỏ trống = disk volume; R2/MinIO cần ENDPOINT + FORCE_PATH_STYLE=1).
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE=""
S3_PUBLIC_BASE=""

# Thông báo concierge (optional).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Hóa đơn điện tử (đủ 3 biến = tự phát hành khi đơn PAID).
EINVOICE_PROVIDER=""
EINVOICE_API_URL=""
EINVOICE_API_KEY=""

# Backup: số bản giữ lại.
BACKUP_KEEP="14"
# Offsite backup (rclone remote, vd "b2:aurel-backups" hoặc "s3:bucket/clock").
# Bỏ trống = chỉ giữ backup local (mất ổ VPS là mất cả hai — prod thật nên đặt).
# Compose có sidecar `db-offsite` tự đẩy lên remote 03:00 mỗi ngày (không cần
# crontab VPS). Cần 1 lần: `rclone config` trên host tạo remote, rồi set
# OFFSITE_RCLONE_CONFIG=/root/.config/rclone/rclone.conf (mặc định /dev/null).
OFFSITE_REMOTE=""
# Số NGÀY giữ bản trên remote — dài hơn local (14 bản) để còn cứu khi dữ
# liệu hỏng âm thầm đã lan vào cả bản local.
OFFSITE_KEEP="30"
# Đường dẫn rclone.conf trên host (mount read-only vào sidecar).
OFFSITE_RCLONE_CONFIG="/root/.config/rclone/rclone.conf"

# CDN media tĩnh (optional — bỏ trống = serve local từ frontend).
# Khi có R2/bucket + domain riêng (xem docs/PRODUCTION.md mục media):
# NEXT_PUBLIC_MEDIA_BASE_URL="https://media.shop.example.com"
NEXT_PUBLIC_MEDIA_BASE_URL=""

# Sentry (optional — bỏ trống = noop; có DSN thì lỗi 5xx + UI crash được báo về).
# Tạo project miễn phí ở sentry.io → lấy DSN.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="prod-vps"
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT="prod-vps"

# Method thanh toán mô phỏng — prod luôn tắt bất kể giá trị (guard trong code).
ENABLE_SIMULATED_METHODS="0"

# AI agents (service agent trong docker-compose.prod.yml; Caddy route /agent/*).
# Gateway tương thích Anthropic Messages API (bỏ trống = api.anthropic.com).
AGENT_BASE_URL=""
AGENT_API_KEY=""
AGENT_MODEL="claude-sonnet-5"
AGENT_AUTH_HEADER="x-api-key"
# Jev TypeSafe — decision model (phân loại khiếu nại ngầm ý + triage +
# alert-gate + injection gate + intent hint). Lấy key ở console.typesafe.ai.
# Thiếu key = Jev tắt, hệ thống fallback heuristic (recall 1/6 thay vì 4/6).
JEV_API_KEY=""
JEV_URL="https://api.typesafe.ai/v1/systemone"
JEV_MODEL="jev-latest"
# Model dự phòng khi gateway chính 429/overloaded (rỗng = không fallback).
AGENT_FALLBACK_MODEL=""
# Model nhỏ riêng cho memory extraction (rỗng = dùng AGENT_MODEL — đắt hơn).
AGENT_MEMORY_MODEL=""
# Token bảo vệ /merchant/* + feed ops (header x-agent-token) — prod BẮT BUỘC
# đặt chuỗi ngẫu nhiên (openssl rand -hex 32). Compose prod bật
# AGENT_REQUIRE_MERCHANT_TOKEN=1 nên thiếu token này host sẽ không chạy.
# Token chỉ sống phía server (Next route + agent host), KHÔNG đưa vào
# NEXT_PUBLIC_* (xuống browser là lộ cho mọi visitor).
AGENT_MERCHANT_TOKEN=""
AGENT_CHAT_RATE_LIMIT_PER_MIN="60"
# Shopper demo cho shopping agent (tự register nếu chưa có).
AGENT_SHOPPER_EMAIL="agent-shopper@aurel.local"
AGENT_SHOPPER_PASSWORD=""
# Merchant agent dùng tài khoản ADMIN seed ở trên (ADMIN_EMAIL/ADMIN_PASSWORD).

# Meilisearch — typo-tolerance search cho catalog (service trong compose).
# Bắt buộc ở prod (compose fail-fast khi thiếu); ngẫu nhiên ≥16 ký tự.
MEILI_MASTER_KEY=""
