# Caddy reverse proxy + TLS tự động (Let's Encrypt).
# Thay example.com bằng domain thật, trỏ DNS A về IP VPS trước khi up.
{
	admin off
}

{$DOMAIN:example.com} {
	# Frontend (Next.js)
	handle {
		reverse_proxy frontend:3000
	}

	# Backend API giữ cùng domain để cookie first-party:
	# FE gọi /backend/* → proxy sang backend:4000 (xem next.config rewrites).
	handle_path /backend/* {
		reverse_proxy backend:4000
	}

	# AI agents (cùng origin để tránh CORS prod): FE gọi /agent/* → host :8100.
	# CHỈ endpoint public của shop được đi thẳng; các route ops (merchant,
	# activity, monitor/run, alerts ops-scope) PHẢI qua Next /api/agent/*
	# — nơi verify role ADMIN. Để mở /agent/* = bỏ qua admin-gate, chỉ còn
	# 1 token tĩnh (audit SEC finding).
	handle_path /agent/merchant* {
		respond 404
	}
	handle_path /agent/activity {
		respond 404
	}
	handle_path /agent/shop/monitor* {
		respond 404
	}
	handle_path /agent/* {
		reverse_proxy agent:8100
	}

	# A2A (agent ngoai) + AgentCard: cung origin, TLS + rate-limit cua Caddy.
	handle_path /a2a* {
		reverse_proxy agent:8100
	}
	handle /.well-known/agent-card.json {
		reverse_proxy agent:8100
	}

	encode gzip
	log {
		output stdout
		format json
	}
}
