generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  phone        String?
  passwordHash String?
  role         Role       @default(CUSTOMER)
  tokenVersion Int        @default(0)
  orders       Order[]
  cartItems    CartItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Product {
  slug             String   @id
  name             String
  reference        String   @unique
  collection       String
  priceUsd         Int
  priceVnd         BigInt
  shortDescription String   @db.Text
  badges           String[]
  strapLabel       String
  cardImage        String
  images           String[]
  calibre          String
  diameterMm       Float
  caseMaterial     String
  complications    String[]
  inBoutique       Boolean  @default(true)
  specs            Json
  narrative        String   @db.Text
  orderItems       OrderItem[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Order {
  id           String      @id @default(cuid())
  code         String      @unique
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  customerName String
  contact      String
  address      String
  slot         String?
  status       OrderStatus @default(PENDING)
  totalUsd     Int
  totalVnd     BigInt
  items        OrderItem[]
  payments     Payment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productSlug String?
  product     Product? @relation(fields: [productSlug], references: [slug])
  name        String
  priceUsd    Int
  priceVnd    BigInt
  image       String
  strap       String
  engraving   String?
  qty         Int      @default(1)

  @@index([orderId])
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method    String
  amountUsd Int
  status    PaymentStatus @default(PENDING)
  txnRef    String?
  createdAt DateTime      @default(now())

  @@index([orderId])
  @@index([txnRef])
}

model CartItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productSlug String
  name        String
  priceUsd    Int
  priceVnd    BigInt
  image       String
  strap       String
  engraving   String?
  qty         Int      @default(1)
  updatedAt   DateTime @updatedAt

  @@unique([userId, productSlug, strap])
  @@index([userId])
}
