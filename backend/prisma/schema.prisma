generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
  // Đã hoàn tiền cho khách (tiền đã thu qua VNPay rồi trả lại): trạng thái
  // cuối, hoàn tồn kho, giữ nguyên paidUsd làm sổ đã thu + refundRef trong
  // OrderEvent. PAID không được → CANCELLED trực tiếp nữa (audit BIZ-HIGH-02).
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  phone         String?
  passwordHash  String?
  role          Role            @default(CUSTOMER)
  tokenVersion  Int             @default(0)
  orders        Order[]
  cartItems     CartItem[]
  wishlist      WishlistItem[]
  delegationKey DelegationKey[]
  paymentIntents PaymentIntent[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

/// Bản ghi refresh cho vé delegation của agent (volatile, dùng 1 lần).
/// - `key` = dkey trong payload JWT — đoán được mới dùng được;
/// - `version` = tokenVersion lúc cấp — logout/đổi pass làm lệch → refresh chết;
/// - `expiresAt` = vé + 24h — refresh quá hạn cũng chết (FE xin vé mới).
/// Không lưu secret/password — lộ bảng này cũng không giả được session.
model DelegationKey {
  key       String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version   Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Product {
  slug             String   @id
  name             String
  reference        String   @unique
  collection       String
  priceUsd         Int
  priceVnd         BigInt
  shortDescription String   @db.Text
  badges           String[]
  strapLabel       String
  cardImage        String
  images           String[]
  calibre          String
  diameterMm       Float
  caseMaterial     String
  complications    String[]
  inBoutique       Boolean  @default(true)
  stock            Int      @default(1)
  specs            Json
  narrative        String   @db.Text
  orderItems       OrderItem[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // List catalog: filter theo bộ sưu tập + sort giá; sort newest (audit DB-001).
  @@index([collection, priceUsd])
  @@index([createdAt])
}

model Order {
  id           String      @id @default(cuid())
  code         String      @unique
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  customerName String
  contact      String
  address      String
  slot         String?
  status       OrderStatus @default(PENDING)
  totalUsd     Int
  totalVnd     BigInt
  // Đã thu (deposit 20% hoặc full). Còn lại = total - paid.
  paidUsd      Int         @default(0)
  paidVnd      BigInt      @default(0)
  // Khách đã tick đồng ý Điều khoản + Chính sách bảo mật lúc checkout
  // (bằng chứng consent — Nghị định 13/2023). BE bắt buộc, không tin client.
  agreedTerms  Boolean     @default(false)
  items        OrderItem[]
  payments     Payment[]
  events       OrderEvent[]
  paymentIntents PaymentIntent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productSlug String?
  product     Product? @relation(fields: [productSlug], references: [slug])
  name        String
  priceUsd    Int
  priceVnd    BigInt
  image       String
  strap       String
  engraving   String?
  qty         Int      @default(1)

  @@index([orderId])
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method    String
  amountUsd Int
  status    PaymentStatus @default(PENDING)
  txnRef    String?
  // Số VND kỳ vọng lúc tạo URL — settle so với giá trị đóng băng này,
  // không đọc lại total (tránh mismatch khi giá đổi giữa chừng).
  expectedVnd BigInt?
  createdAt DateTime      @default(now())

  @@index([orderId])
  @@index([txnRef])
}

/// Hạn mức user duyệt TRƯỚC để agent thanh toán hộ (agentic checkout).
/// - `maxUsd` = trần user cho phép cho intent này (BE chốt tổng đơn ≤ trần);
/// - `status`: ACTIVE (chưa dùng) → USED (đã chốt 1 đơn) / EXPIRED / REVOKED;
/// - dùng 1 lần, hết hạn ngắn (mặc định 15 phút) — lộ intent cũng không tái
///   dùng được, và không bao giờ thay được session (vẫn cần delegation).
/// - `orderId`/`usedAt` = đơn đã chốt — đối chiếu khi khiếu nại.
model PaymentIntent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  maxUsd    Int
  method    String   @default("vnpay")
  status    String   @default("ACTIVE")
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, status, createdAt])
}

model CartItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productSlug String
  name        String
  priceUsd    Int
  priceVnd    BigInt
  image       String
  strap       String
  engraving   String?
  qty         Int      @default(1)
  updatedAt   DateTime @updatedAt

  @@unique([userId, productSlug, strap])
  @@index([userId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  from      OrderStatus?
  to        OrderStatus
  byUserId  String?
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

/// Idempotency-Key cho POST /orders: retry mạng/double-click gửi cùng key
/// thì trả về đơn cũ thay vì tạo đơn mới + trừ kho lần nữa. Key gắn với
/// chủ sở hữu (userId, hoặc contactHash cho khách vãng lai) — key của người
/// này không moi được đơn người khác. Cron dọn key quá 24h.
model IdempotencyKey {
  key         String   @id
  userId      String?
  contactHash String?
  orderId     String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model WishlistItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productSlug String
  createdAt   DateTime @default(now())

  @@unique([userId, productSlug])
  @@index([userId])
}

model ProductEvent {
  id        String   @id @default(cuid())
  slug      String
  action    String
  /// Danh tính: user id, hoặc `id:agent/shopping` khi agent thay user
  /// (delegation). Xem `resolveActor` ở backend/src/common/session.ts.
  byUserId  String?
  summary   String?
  /// Diff old/new từng field của lần sửa này (audit tự nhận: trước đây
  /// chỉ ghi tên field đổi). null cho event cũ / event không phải UPDATE.
  changes   Json?
  createdAt DateTime @default(now())

  @@index([slug, createdAt])
}

/// Khuyến mãi theo khung ngày (merchant agent stage/apply).
/// Apply = tạo bản ghi + cập nhật giá SP về giá KM (guardrail cap
/// max_promotion_discount_pct ở agent ledger). Giá gốc snapshot ở
/// priceSnapshot ({slug: priceUsd}) lúc tạo — cron hết hạn hồi giá từ đây
/// (audit BIZ-HIGH-02: trước đây giá KM ở lại vĩnh viễn sau endsAt).
model Promotion {
  id          String   @id @default(cuid())
  name        String
  listingSlugs String[]
  discountPct Float
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean  @default(true)
  /// Snapshot giá gốc USD theo slug lúc tạo promotion (để hồi giá khi hết hạn).
  priceSnapshot Json?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, endsAt])
}

/// Chiến dịch marketing (merchant agent stage/apply).
/// `spend`/`revenue` để null khi kênh chưa báo — không dùng số 0 giả.
model Campaign {
  id        String   @id @default(cuid())
  name      String
  objective String?
  audience  String?
  budgetUsd Int      @default(0)
  spendUsd  Int?
  revenueUsd Int?
  copyText  String?  @db.Text
  status    String   @default("draft") /// draft | active | paused | ended
  startsAt  DateTime?
  endsAt    DateTime?
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

/// Form "Đặt lịch Private Salon" (trang chủ / atelier) và đơn đăng ký
/// bespoke (configurator) — trước đây chỉ là mock frontend.
model Inquiry {
  id        String   @id @default(cuid())
  type      String   /// "SALON" | "BESPOKE"
  name      String
  phone     String
  email     String?
  message   String?
  /// JSON: lựa chọn configurator (movement/case/dial/personal) hoặc salon location
  payload   Json?
  status    String   @default("NEW") /// NEW | CONTACTED | CLOSED
  createdAt DateTime @default(now())

  @@index([type, status, createdAt])
}

/// Hóa đơn điện tử cho đơn đã PAID — sinh khi VNPay confirm. `status`:
/// PENDING_ISSUE (chưa gửi nhà cung cấp) | ISSUED (đã có số hóa đơn) | FAILED.
/// `externalRef` = mã hóa đơn nhà cung cấp e-invoice (MISA, EasyInvoice...).
model Invoice {
  id          String   @id @default(cuid())
  orderCode   String   @unique
  number      String?  /// Số hóa đơn dạng AUR-YYYY-XXXXX sau khi phát hành
  externalRef String?  /// Mã tham chiếu nhà cung cấp e-invoice
  status      String   @default("PENDING_ISSUE")
  // BigInt: đơn flagship $145k × 25.200 = 3,65 tỷ VND, vượt trần Int32
  // (2.147.483.647) — Int làm invoice đơn lớn throw âm thầm (audit DATA-CRIT).
  amountVnd   BigInt
  buyerName   String
  buyerEmail String?
  createdAt   DateTime @default(now())
  issuedAt    DateTime?

  @@index([status, createdAt])
}
