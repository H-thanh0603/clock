# Copy thành .env và chỉnh lại cho môi trường của bạn.
PORT=4000
# SPA/Next frontend (CORS origin + nơi VNPay return redirect về)
FRONTEND_URL="http://localhost:3100"
# URL public của chính backend (VNPay gọi return/ipn về đây)
BACKEND_PUBLIC_URL="http://localhost:4000"

# PostgreSQL (dùng chung DB với frontend cũ)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/aurel"

# Meilisearch — typo-tolerance search cho catalog (bỏ trống = fallback
# Prisma contains). Dev: service `meilisearch` trong docker-compose.yml.
# MEILI_HOST="http://localhost:7700"
# MEILI_MASTER_KEY="dev-meili-key-0123456789"

# Secret ký session cookie (tự sinh chuỗi ngẫu nhiên khi deploy)
JWT_SECRET="thay-bang-chuoi-ngau-nhien-64-ky-tu"

# Cookie phiên: dev localhost khác port vẫn cùng-site nên Lax là đủ.
# Deploy khác domain + HTTPS: COOKIE_SAMESITE=none + COOKIE_SECURE=true.
#COOKIE_SAMESITE="lax"
#COOKIE_SECURE="false"

# VNPay sandbox (để trống: API create sẽ báo thiếu cấu hình)
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
#VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"

# Thư mục lưu ảnh upload admin (mặc định ./uploads).
#UPLOADS_DIR="./uploads"

# Thông báo đơn hàng (tất cả optional — thiếu thì bỏ qua êm).
# Telegram admin: tạo bot qua @BotFather, lấy chat id rồi điền.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Email SMTP (vd Gmail App Password, Resend, SES).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Aurel & Co. <no-reply@example.com>"

# "production" = cổng VNPay thật (vnpayment.vn), bỏ qua VNPAY_URL.
# Bỏ trống / "sandbox" = cổng sandbox hiện tại.
VNPAY_ENV=""

# --- Ảnh upload S3-compatible (AWS S3 / Cloudflare R2 / MinIO) ---
# Điền S3_BUCKET để bật; bỏ trống = lưu disk (volume) như cũ.
# R2/MinIO cần S3_ENDPOINT + S3_FORCE_PATH_STYLE=1.
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE=""
# Domain public/CDN phục vụ ảnh (vd: https://cdn.example.com)
S3_PUBLIC_BASE=""

# --- Hóa đơn điện tử (e-invoice) ---
# Điền đủ 3 biến để tự phát hành khi đơn PAID; bỏ trống = invoice nằm
# PENDING_ISSUE, kế toán phát hành qua portal nhà cung cấp.
EINVOICE_PROVIDER=""
EINVOICE_API_URL=""
EINVOICE_API_KEY=""

# Method thanh toán mô phỏng (centurion/escrow/deposit/cod). Mặc định: BẬT
# ở dev/demo, LUÔN TẮT khi NODE_ENV=production (chỉ VNPay thật).
# "0" = tắt cả ở dev.
ENABLE_SIMULATED_METHODS=""

# Đơn PENDING quá số giờ này sẽ tự hủy + hoàn tồn kho (cron mỗi giờ).
ORDER_PENDING_TTL_HOURS="24"

# --- Jev (TypeSafe AI, decision model cho web: inquiry triage/spam gate,
# search hint, order risk advisory, admin copy guardrail) ---
# Cùng key với agent host. Thiếu JEV_API_KEY = Jev tắt, web chạy như cũ.
# Key lấy ở https://console.typesafe.ai/keys.
JEV_API_KEY=""
JEV_URL="https://api.typesafe.ai/v1/systemone"
JEV_MODEL="jev-latest"
JEV_TIMEOUT_S="5"
